# ─── LLM ─────────────────────────────────────────────────────────────────────
# Provider: mock | gemini | openai | ollama
LLM_PROVIDER=mock
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-1.5-flash
# For Ollama: LLM_BASE_URL=http://localhost:11434, LLM_MODEL=qwen2.5

# ─── Market data ─────────────────────────────────────────────────────────────
USE_MOCK_DATA=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINGECKO_API_KEY=

# ─── Blockchain ──────────────────────────────────────────────────────────────
SIMULATION_MODE=true
RPC_URL=https://mainnet.hsk.xyz
CHAIN_ID=177
PRIVATE_KEY=
VAULT_ADDRESS=
TRADE_EXEC_ADDRESS=
PAYFI_ADDRESS=

# ─── App ─────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./finagentx.db
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ─── Risk ────────────────────────────────────────────────────────────────────
MAX_TRADE_SIZE_PCT=10
MAX_DRAWDOWN_PCT=15
STOP_LOSS_PCT=5
MAX_RISK_SCORE=70

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
